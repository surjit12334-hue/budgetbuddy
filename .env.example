# BudgetBuddy environment variables
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.

# === Agent identity / network ===
HOST_SEED="replace with a long unique seed phrase for your host agent"
HOST_PORT=8001
# Local endpoint the Bureau serves on
HOST_ENDPOINT=http://localhost:8001

# === LLM (OPTIONAL - everything degrades gracefully without it) ===
# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# LLM call tuning: kept short so a stalled Gemini call falls back fast
GEMINI_TIMEOUT_SECONDS=10
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_DELAY_SECONDS=1
# Local fallback if you run Ollama (https://ollama.com)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# === Behaviour ===
# Currency all totals are reported in (multi-currency data is converted via frankfurter.app, free)
REPORT_CURRENCY=USD
# Interactive cards (ASI:One drawers).  Schema verified against
# https://innovationlab.fetch.ai/resources/docs/interactive-cards/asi-interactive-cards
# Cards are ADDITIVE: the markdown reply is always sent, so turning this on
# can never cost a user their answer.  tests/test_cards.py + test_cards_live.py
# guard the schema.  Set to false for a pure-text chat.
ENABLE_CARDS=true
# Sessions (and the transaction data they contain) are purged after this many hours
SESSION_TTL_HOURS=24
# Sub-agent timeout before the orchestrator falls back to in-process logic
AGENT_TIMEOUT_SECONDS=15

# === Phase 6 — Payment (Agent Payment Protocol, seller role) ===
# BudgetBuddy is the SELLER: it sends RequestPayment, handles
# CommitPayment / RejectPayment, and answers with CompletePayment /
# CancelPayment.  Pick a rail:
#
#   auto        pick the first rail that is actually usable (default)
#   bb_commit   the buyer signs the seller's per-request challenge with
#               its uAgents identity key; the seller verifies it against
#               the sender's agent1q... address.  NO credentials needed.
#   stripe      real card payments via Stripe Checkout (test keys below)
#   fet_direct  on-chain FET on MultiversX (needs a funded wallet)
#
# Whatever the rail, a failed verification is answered with
# CancelPayment — never with an unlock.
PAYMENT_RAIL=auto
# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# On-chain rail: the wallet that receives the payment, and the network
# (devnet | testnet | mainnet)
AGENT_WALLET_ADDRESS=
PAYMENT_NETWORK=devnet

# === Phase 5 — Going Live (Agentverse via mailbox) ===
# The host agent connects OUT to Agentverse via a mailbox, so it is
# reachable from ASI:One with NO public URL and NO ngrok tunnel.
ENABLE_MAILBOX=true
ENABLE_AGENTVERSE=true
# After the first run, create the mailbox in Agentverse (Agent Inspector).
# Once created, the agent picks up messages automatically — no restart.
#
# Verify locally before touching ASI:One:
#   .venv/bin/python tools/preflight.py
